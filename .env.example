# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key-goes-here

# Secret used to sign run tokens. Any long random string.
RUN_TOKEN_SECRET=change-me-to-64-random-characters

# Opens /admin?key=...
ADMIN_KEY=change-me-too

# Absolute URL of the deployed game, used for the QR codes on the booth
# display and on the shared score card.
NEXT_PUBLIC_GAME_URL=https://ecell-runner.vercel.app
